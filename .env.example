# Telegram bot token from @BotFather
BOT_TOKEN=
# Public base URL of this deployment, e.g. https://your-space.hf.space (no trailing slash)
WEBHOOK_BASE_URL=
# Random secret string; Telegram sends it back in a header on every webhook call
WEBHOOK_SECRET=
# Supabase Postgres connection string (postgres://... or postgresql://...)
DATABASE_URL=
# NVIDIA API key (build.nvidia.com — primary provider in the rotation)
NVIDIA_API_KEY=
# NVIDIA model name (optional)
NVIDIA_MODEL=meta/llama-3.2-90b-vision-instruct
# OpenRouter API key (optional provider in the rotation)
OPENROUTER_API_KEY=
# OpenRouter model name (optional; "openrouter/free" picks a free model)
OPENROUTER_MODEL=openrouter/free
# Groq API key (optional provider in the rotation)
GROQ_API_KEY=
# Groq model name (optional)
GROQ_MODEL=openai/gpt-oss-120b
# LLM provider rotation order, comma-separated: nvidia, openrouter, groq (optional)
LLM_PROVIDER_ORDER=nvidia,openrouter,groq
# Fuzzy pair-matching threshold, pg_trgm similarity 0-1 (optional)
PAIRS_FUZZY_THRESHOLD=0.45
# Fuzzy pair-matching threshold for the RapidFuzz layer, score 0-100 (optional)
PAIRS_RF_THRESHOLD=78
# Admin dashboard key — set this to enable the /admin web panel (optional;
# while empty, /admin does not exist). Use a long random string.
ADMIN_PANEL_KEY=
# Minutes a provider is skipped after a 429/quota error (optional)
LLM_COOLDOWN_MINUTES=60
# Bot owner's Telegram user id (numeric) — can seed the sticker pool, future admin tools
ADMIN_ID=
# Max parallel LLM calls (optional)
LLM_MAX_PARALLEL=10
# Voice-note replies: off | on (optional, feature is a stub in v1)
VOICE_REPLIES=off
# Set to 1 for local development with long polling instead of webhook (optional)
POLLING=0
